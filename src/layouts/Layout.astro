---
// This site is redirect-only. The canonical site lives at https://www.bonyambe.com
// (deployed separately on Vercel). Every page here just redirects visitors and
// search engines to the same path on the new domain, so legacy links like
// bonyambe-sudo.github.io/web/... keep working.
import "../styles/global.css";
import { SITE_NAME } from "@/lib/seoConfig";
import ThemeScript from "@/components/ThemeScript.astro";

interface Props {
  // Optional explicit destination; otherwise derived from the current path.
  redirectTo?: string;
}

const NEW_SITE_ORIGIN = "https://www.bonyambe.com";
const NEW_SITE_LABEL = "www.bonyambe.com";
const base = import.meta.env.BASE_URL; // "/web/"

const buildNewUrl = (): string => {
  const path = Astro.url.pathname;
  const stripped = path.startsWith(base)
    ? path.slice(base.length)
    : path.replace(/^\/web\/?/, "");
  let newPath = stripped.startsWith("/") ? stripped : "/" + stripped;
  // The new site uses clean URLs without trailing slashes. Keep "/" for the root.
  if (newPath.length > 1) newPath = newPath.replace(/\/+$/, "");
  if (newPath === "") newPath = "/";
  return NEW_SITE_ORIGIN + newPath + Astro.url.search;
};

const newUrl = Astro.props.redirectTo || buildNewUrl();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0;url=${newUrl}`} />
    <link rel="canonical" href={newUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>Redirecting... - {SITE_NAME}</title>
    <ThemeScript />
  </head>
  <body class="bg-background text-foreground">
    <main class="flex min-h-screen items-center justify-center px-6 py-16">
      <div
        class="w-full max-w-md rounded-3xl border border-border bg-card p-8 text-center shadow-xl shadow-border/10 sm:p-10"
      >
        <div
          class="mx-auto mb-6 h-10 w-10 animate-spin rounded-full border-2 border-muted border-t-primary"
          aria-hidden="true"
        >
        </div>
        <h1 class="text-xl font-bold tracking-tight sm:text-2xl">
          Taking you to the new site
        </h1>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">
          This page has moved. Redirecting you now...
        </p>
        <a
          href={newUrl}
          class="mt-6 inline-flex h-12 items-center justify-center rounded-lg bg-primary px-8 text-base font-bold text-primary-foreground shadow-xl transition hover:bg-primary/80"
          >Continue to {NEW_SITE_LABEL}</a
        >
        <p class="mt-5 text-xs break-all text-muted-foreground">{newUrl}</p>
      </div>
    </main>
  </body>
</html>