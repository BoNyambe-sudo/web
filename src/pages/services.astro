---
import Layout from "@/layouts/Layout.astro";
import Services from "@/components/Services.tsx";
import ScrollToTop from "@/components/ScrollToTop.astro";
import { SITE_URL, SITE_DESCRIPTION } from "@/lib/seoConfig";

const base = import.meta.env.BASE_URL;
const images = {
  adminPanel: `${base}services/admin-panel.webp`,
  seo: `${base}services/SEO.webp`,
  responsive: `${base}services/responsive.webp`,
  theme: `${base}services/dark-and-light-mode.webp`,
  accessibility: `${base}services/accessiblity.webp`,
  performance: `${base}services/perfomance.webp`,
};
---

<Layout
  title="Services & Tech Stack"
  description="Explore my tech stack, services, projects, and contact information. See examples of custom admin panels, SEO-optimized sites, responsive designs, and more."
  keywords="tech stack, services, projects, Angular, Nest JS, MongoDB, Node.js, contact, portfolio, NestJS Angular developer, web development, Web development services in Zambia,SEO web design, performance optimization, Zambia web developer, website development Zambia, website design Zambia, software development Zambia, web developer Lusaka, responsive web design, ecommerce website Zambia, SEO services Zambia, custom software development, WordPress development Zambia"
  canonical={`${SITE_URL}services/`}
  type="website"
>
  <ScrollToTop />

  <h1 class="sr-only">Web Developement Services - Custom Websites, UI/UX & SEO</h1>
  <p class="sr-only">I build fast, modern websites using Astro or Angular  and Nest JS. My services are designed to help small business get online quickly with SEO-friendly, high-perfromance sites.
  From landing pages to full-featured web applications, I can help you create a website that meets your needs and exceeds your expectations. 
  </p>

  <p class="sr-only">
    My core services include custom website development, UI/UX design, performance optimization, and ongoing maintainance. Every project is built to pass Core Web Vitals, Bing and Google quality checks, and includes proper schema markup.
  </p>

  <Services images={images} client:load />

  <section class="sr-only">
    <h2>What I Offer</h2>
    <ul>
      <li>
        <h3>Custom Web Development</h3>
        <p>Astro + React or Angular, fast and SEO optimized.</p>
      </li>
      <li>
        <h3>UI/UX Design</h3>
        <p>Modern, responsive designs that convert.</p>
      </li>
      <li>
        <h3>Perfomance & SEO</h3>
        <p>Fixes for indexing, schema, and Core Web Vitals</p>
      </li>
    </ul>
  </section>
</Layout>
