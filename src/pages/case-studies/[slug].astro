---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ScrollToTop from "@/components/ScrollToTop.astro";
import { getCaseStudy, getAllCaseStudySlugs, caseStudies } from "@/lib/caseStudies";
import { SITE_URL } from "@/lib/seoConfig";
import { formatDateShort } from "@/lib/formattedDate";

export async function getStaticPaths() {
  const slugs = getAllCaseStudySlugs();
  return slugs.map((slug) => ({
    params: { slug },
    props: { caseStudy: getCaseStudy(slug)! },
  }));
}

interface Props {
  caseStudy: typeof caseStudies[0];
}

const { caseStudy } = Astro.props;

const canonical = `${SITE_URL}case-studies/${caseStudy.slug}/`;
---

<Layout
  title={caseStudy.title}
  description={caseStudy.description}
  keywords={caseStudy.techStack.map(t => t.name).join(", ") + ", case study, portfolio, web development"}
  image={caseStudy.thumbnail}
  type="article"
  canonical={canonical}
>
  <ScrollToTop />
  <Header />
  <main class="container py-10">
    <nav
      class="flex items-center gap-2 text-sm text-muted-foreground mb-8"
      aria-label="Breadcrumb"
    >
      <a href="/web/" class="hover:text-primary">Home</a>
      <span>/</span>
      <a href="/web/case-studies/" class="hover:text-primary">Case Studies</a>
      <span>/</span>
      <span class="text-foreground">{caseStudy.title}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <div class="lg:col-span-3 space-y-12">
        <header class="space-y-4">
          <div class="flex items-center gap-3 flex-wrap">
            <span
              class="px-3 py-1 bg-primary/10 text-primary rounded-full text-sm font-medium"
            >{caseStudy.badge}</span>
            <div class="flex items-center gap-1 text-sm text-muted-foreground">
              <span class="text-foreground">Case Study</span>
            </div>
          </div>
          <h1 class="text-3xl lg:text-4xl font-bold">{caseStudy.title}</h1>
          <p class="text-lg text-muted-foreground max-w-2xl">{caseStudy.tagline}</p>
        </header>

        <div class="flex flex-wrap gap-3">
          <a
            href={caseStudy.links.live}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 h-10 px-6 rounded-lg bg-primary text-primary-foreground font-semibold hover:bg-primary/80 transition"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            View Live Project
          </a>
          <a
            href={caseStudy.links.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 h-10 px-6 rounded-lg border border-border bg-background text-foreground font-semibold hover:bg-muted transition"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
            View Source Code
          </a>
        </div>

        <section class="prose prose-lg max-w-none">
          <h2>Overview</h2>
          <p>{caseStudy.overview}</p>
        </section>

        <section class="prose prose-lg max-w-none">
          <h2>Architecture</h2>
          <pre class="bg-muted p-4 rounded-lg overflow-x-auto text-sm"><code>{caseStudy.architecture}</code></pre>
        </section>

        <section class="prose prose-lg max-w-none">
          <h2>Key Design Decisions</h2>
          <ul>
            {caseStudy.keyDecisions.map((decision) => (
              <li>{decision}</li>
            ))}
          </ul>
        </section>

        <section class="prose prose-lg max-w-none">
          <h2>Features Implemented</h2>
          {caseStudy.features.map((feature) => (
            <div class="mb-6">
              <h3>{feature.title}</h3>
              <ul>
                {feature.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </section>

        {caseStudy.projectStructure && (
          <section class="prose prose-lg max-w-none">
            <h2>Project Structure</h2>
            <pre class="bg-muted p-4 rounded-lg overflow-x-auto text-sm"><code>{caseStudy.projectStructure}</code></pre>
          </section>
        )}

        <section class="prose prose-lg max-w-none">
          <h2>Challenges & Solutions</h2>
          {caseStudy.challenges.map((challenge) => (
            <div class="mb-6 p-4 rounded-lg bg-card border border-border">
              <h3 class="font-semibold mb-2">{challenge.title}</h3>
              <p>{challenge.solution}</p>
            </div>
          ))}
        </section>

        {caseStudy.results && caseStudy.results.length > 0 && (
          <section class="prose prose-lg max-w-none">
            <h2>Results</h2>
            <table class="w-full border-collapse">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left p-3 font-semibold">Metric</th>
                  <th class="text-left p-3 font-semibold">Target</th>
                </tr>
              </thead>
              <tbody>
                {caseStudy.results.map((result) => (
                  <tr class="border-b border-border/50">
                    <td class="p-3">{result.metric}</td>
                    <td class="p-3 font-medium">{result.target}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        )}

        {caseStudy.performance && caseStudy.performance.length > 0 && (
          <section class="prose prose-lg max-w-none">
            <h2>Performance & Reliability</h2>
            <ul>
              {caseStudy.performance.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )}

        <section class="prose prose-lg max-w-none">
          <h2>Future Enhancements</h2>
          <ul>
            {caseStudy.futureEnhancements.map((enhancement) => (
              <li>{enhancement}</li>
            ))}
          </ul>
        </section>

        <section class="prose prose-lg max-w-none">
          <h2>Deployment</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="p-4 rounded-lg bg-muted">
              <h3 class="font-semibold mb-2">Frontend</h3>
              <p>{caseStudy.deployment.frontend}</p>
            </div>
            <div class="p-4 rounded-lg bg-muted">
              <h3 class="font-semibold mb-2">Backend</h3>
              <p>{caseStudy.deployment.backend}</p>
            </div>
            <div class="p-4 rounded-lg bg-muted">
              <h3 class="font-semibold mb-2">Database</h3>
              <p>{caseStudy.deployment.database}</p>
            </div>
            <div class="p-4 rounded-lg bg-muted">
              <h3 class="font-semibold mb-2">CI/CD</h3>
              <p>{caseStudy.deployment.ci}</p>
            </div>
          </div>
        </section>

        <section class="prose prose-lg max-w-none">
          <h2>Tech Stack</h2>
          <div class="flex flex-wrap gap-2">
            {caseStudy.techStack.map((tech) => (
              <span
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-medium"
                style={`background-color: ${tech.color}20; color: ${tech.color}`}
              >
                {tech.name}
              </span>
            ))}
          </div>
        </section>
      </div>

      <aside class="lg:col-span-1">
        <div class="sticky top-20 space-y-6">
          <div class="rounded-xl border border-border bg-card p-6">
            <h3 class="font-semibold mb-4">Project Links</h3>
            <div class="space-y-3">
              <a
                href={caseStudy.links.live}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 w-full px-4 py-2 rounded-lg bg-primary text-primary-foreground font-medium hover:bg-primary/80 transition"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                Live Demo
              </a>
              <a
                href={caseStudy.links.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 w-full px-4 py-2 rounded-lg border border-border bg-background text-foreground font-medium hover:bg-muted transition"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                GitHub Repository
              </a>
            </div>
          </div>

          <div class="rounded-xl border border-border bg-card p-6">
            <h3 class="font-semibold mb-4">Technologies Used</h3>
            <div class="space-y-2">
              {caseStudy.techStack.map((tech) => (
                <div
                  class="flex items-center gap-3 p-2 rounded-lg hover:bg-muted/50 transition"
                >
                  <span
                    class="w-8 h-8 rounded-full flex items-center justify-center text-white text-sm font-bold"
                    style={`background-color: ${tech.color}`}
                  >
                    {tech.name.charAt(0)}
                  </span>
                  <span class="text-sm font-medium">{tech.name}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="rounded-xl border border-primary/20 bg-linear-to-br from-primary/5 to-background p-6">
            <h3 class="font-semibold mb-3 text-primary">Interested in a similar project?</h3>
            <p class="text-sm text-muted-foreground mb-4">
              Let's discuss how I can build a custom solution for your business needs.
            </p>
            <a
              href="/web/website-survey/"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition hover:bg-primary/80"
            >
              Book a Strategy Call
            </a>
          </div>
        </div>
      </aside>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .prose h2 {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--foreground);
  }
  .prose h3 {
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--foreground);
  }
  .prose p {
    color: var(--muted-foreground);
    line-height: 1.75rem;
    margin-bottom: 1rem;
  }
  .prose ul {
    list-style-type: disc;
    list-style-position: inside;
    margin-bottom: 1rem;
    color: var(--muted-foreground);
  }
  .prose li {
    line-height: 1.75rem;
  }
  .prose pre {
    background-color: var(--muted);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }
  .prose code {
    background-color: var(--muted);
    padding: 0.25rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-family: monospace;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
  }
  .prose th, .prose td {
    border: 1px solid var(--border);
    padding: 0.75rem;
    text-align: left;
  }
  .prose th {
    background-color: var(--muted);
    font-weight: 600;
  }
</style>
</Layout>