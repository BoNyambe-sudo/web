---
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = "" } = Astro.props;

import NestJS from "./NestJS.astro";
import Angular from "./Angular.astro";
import MongoDB from "./MongoDB.astro";
import AstroIcon from "./Astro.astro";
import Sanity from "./Sanity.astro";
import NextJS from "./NextJS.astro";
---

{
  name.toLowerCase() === "nestjs" && <NestJS  class={className} size={size} />
}
{
  name.toLowerCase() === "angular" && <Angular  class={className} size={size} />
}
{
  name.toLowerCase() === "mongodb" && <MongoDB  class={className} size={size} />
}
{
  name.toLowerCase() === "astro" && <AstroIcon  class={className} size={size} />
}
{
  name.toLowerCase() === "sanity" && <Sanity  class={className} size={size} />
}
{
  name.toLowerCase() === "nextjs" && <NextJS  class={className} size={size} />
}